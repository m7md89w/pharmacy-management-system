# ============================================================
# PHARMACY MANAGEMENT SYSTEM — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.
# ============================================================

# ----------------------------------
# Flask
# ----------------------------------
# Set to "true" ONLY during local development, never in production
FLASK_DEBUG=false
PORT=5000

# ----------------------------------
# JWT Authentication
# ----------------------------------
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRE_HOURS=24

# ----------------------------------
# Database
# ----------------------------------
# Leave empty to use the default SQLite path (pharmacy.db in project root)
# For PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ----------------------------------
# Seed Data (only used when running seed_data.py)
# ----------------------------------
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
